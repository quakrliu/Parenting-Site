---
import BlogPost from '../../../layouts/BlogPost.astro';
import { getCollection } from 'astro:content';

const lang = 'zh';

export async function getStaticPaths() {
  // Only Chinese posts live under /zh/ — English posts are built under /en/ only
  const posts = (await getCollection('blog')).filter((post) => post.data.lang === 'zh-TW');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<BlogPost post={post} lang={lang} pageUrl={Astro.url.href} />
