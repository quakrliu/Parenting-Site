---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import NewsletterForm from '../../../../components/NewsletterForm.astro';
import '../../../../styles/landing.css';

const lang = 'zh';
const appStoreUrl = 'https://apps.apple.com/tw/app/%E8%82%B2%E8%A6%8B%E6%9C%AA%E4%BE%86-bloompath/id6759791532';

const questionGroups = [
  {
    title: 'A. 教學：是不是真的蒙特梭利',
    questions: [
      {
        q: '主教老師受過哪一種蒙特梭利師資訓練？在哪裡受訓、訓練多久？',
        why: '招生文宣寫「蒙特梭利」，不代表經過任何蒙特梭利組織認證。',
        good: '能說出訓練體系（例如 AMI、AMS）、年齡層（0–3／3–6／6–12 歲）和訓練長度。以 AMI 3–6 歲師資課程為例，全職上課約需一個學年。',
        warn: '「我們有內部培訓」「老師上過研習」，但說不出課程名稱和時數。',
      },
      {
        q: '班上是混齡嗎？幾歲到幾歲？',
        why: '蒙特梭利以三個年齡為一班（例如 3–6 歲），大孩子帶小孩子是教學的一部分。',
        good: '3–6 歲同一班，各年齡都有。（依法規，2 歲幼兒要獨立成班，這是正常的。）',
        warn: '分成小班、中班、大班，全班同一個進度上課。',
      },
      {
        q: '每天有多長、不被打斷的工作時間？',
        why: 'AMI 的教室標準是每週 5 個上午、每次 3 小時不被打斷的工作時段——孩子的專注力就是在這段時間養成的。',
        good: '上午有連續 2.5–3 小時，孩子自己選工作。',
        warn: '課表切成一堂 30–40 分鐘，中間穿插才藝課或全班活動。',
      },
      {
        q: '孩子怎麼決定要做什麼？老師怎麼決定下一步教他什麼？',
        why: '蒙特梭利的核心是「跟隨孩子」：老師根據觀察，一對一或小組示範教具。',
        good: '老師能說明怎麼從觀察紀錄決定下一個示範，還能舉實際例子。',
        warn: '全班同一時間做同一件事、寫同一本練習本。',
      },
    ],
  },
  {
    title: 'B. 老師與班級',
    questions: [
      {
        q: '一班幾個孩子、幾位老師？其中幾位受過完整的蒙特梭利訓練？',
        why: '《幼兒教育及照顧法》規定：3 歲以上的班最多 30 人，16 人以上要有 2 位教保服務人員；2 歲班最多 16 人，9 人以上要 2 位。這是最低標準。',
        good: '清楚說出人數與配置，而且主教老師受過完整蒙特梭利訓練。',
        warn: '說不清楚，或受過訓練的老師要「輪流」支援好幾班。',
      },
      {
        q: '主教老師在這裡教幾年了？去年有幾位老師離職？',
        why: '老師穩定，孩子才有安全感。',
        good: '主要老師待了好幾年，願意說明老師流動的情況。',
        warn: '迴避問題，或主教老師每學年都換。',
      },
      {
        q: '孩子起衝突時，老師怎麼處理？可以講一個最近的例子嗎？',
        why: '具體例子最能看出學校真正的教養方式。',
        good: '描述怎麼陪孩子說出感受、自己想辦法和好。',
        warn: '罰站、隔離，或只說「我們很重視品格」這類口號。',
      },
      {
        q: '你們怎麼記錄孩子的進度？家長看得到什麼？',
        why: '蒙特梭利老師靠觀察紀錄教學，好的學校會讓你看到孩子的學習歷程。',
        good: '觀察紀錄、作品、定期親師會談。',
        warn: '只有成果發表會、才藝表演，或只談「會寫幾個字」。',
      },
    ],
  },
  {
    title: 'C. 環境與日常',
    questions: [
      {
        q: '可以預約入班觀察至少 30 分鐘嗎？',
        why: '看孩子「正在工作」的樣子，比看空教室和宣傳影片準得多。',
        good: '可以預約觀課（通常會請你安靜坐在旁邊看）。',
        warn: '只能看空教室、只給看影片，或完全不能觀課。',
      },
      {
        q: '教具孩子可以自己拿嗎？壞了或少了零件怎麼處理？',
        why: '蒙特梭利教室的教具是給孩子獨立使用的，完整才能用。',
        good: '教具放在孩子高度的開放式櫃子，完整、乾淨、有固定位置。',
        warn: '教具鎖在櫃子裡、擺著好看，或缺件破損。',
      },
      {
        q: '一天在戶外多久？孩子會做哪些「生活工作」？',
        why: '備餐、倒水、照顧植物、整理環境，是蒙特梭利「日常生活練習」的核心。',
        good: '每天有固定的戶外時間，孩子參與真實的生活工作。',
        warn: '戶外時間「有空才去」，生活大小事都由大人代勞。',
      },
      {
        q: '午餐、午睡、如廁怎麼安排？可以看一下這個月的菜單嗎？',
        why: '孩子一天有一半時間在吃、睡、上廁所，這些細節決定他過得好不好。',
        good: '能具體說明，也願意給你看菜單。',
        warn: '含糊帶過，或說「到時候就知道了」。',
      },
    ],
  },
  {
    title: 'D. 費用與合約',
    questions: [
      {
        q: '學費包含哪些？另外還會收什麼費用？',
        why: '常見的另收項目：註冊費、材料費、餐點費、交通車、課後延托、才藝課、寒暑假營隊、校外教學。',
        good: '一次給你書面的完整收費表。',
        warn: '只報「月費」，其他「到時候再說」。',
      },
      {
        q: '如果中途離開，怎麼退費？可以給我書面的退費規定嗎？',
        why: '立案幼兒園的退費有縣市法規規範。以《臺北市教保服務機構收退費辦法》為例，私立幼兒園學期開始後未超過 1/3 就離開，學費與雜費退 2/3；超過 1/3、未超過 2/3，退 1/3。',
        good: '馬上拿得出書面規定，而且至少符合所在縣市的法規。',
        warn: '「繳了就不退」，或只有口頭說明。不是幼兒園的機構（例如實驗教育機構）規則不同，一定要看書面合約。',
      },
      {
        q: '過去三年學費調過幾次？明年預計調整嗎？',
        why: '你要算的不是一個月，而是讀到畢業的總花費。',
        good: '老實說明調整紀錄和原因。',
        warn: '不願意回答。',
      },
      {
        q: '這裡是準公共幼兒園嗎？有哪些政府補助可以用？學校會協助申請嗎？',
        why: '身分不同，能用的補助和收費規範也不同。',
        good: '清楚說明學校身分和補助申請方式。',
        warn: '說不清楚，或要你「自己去問」。',
      },
    ],
  },
  {
    title: 'E. 溝通與銜接',
    questions: [
      {
        q: '家長多久可以跟老師正式談一次？平常怎麼聯絡？',
        why: '你需要知道孩子在學校的樣子，而不只是活動照片。',
        good: '有固定的親師會談（例如每學期一次），加上清楚的日常聯絡方式。',
        warn: '只有群組公告，沒有一對一的時間。',
      },
      {
        q: '新生怎麼適應？可以漸進式入園嗎？',
        why: '第一個月的經驗，會影響孩子對學校的感覺。',
        good: '有漸進入園的安排，前幾天可以縮短時間。',
        warn: '「第一天就全天，哭幾天就好了」。',
      },
      {
        q: '畢業後孩子通常去哪裡？學校怎麼幫忙銜接？',
        why: '從蒙特梭利轉到一般國小，孩子需要適應「老師主導」的節奏。',
        good: '能說出畢業生的去向，以及具體的銜接做法。',
        warn: '只說「我們的孩子都很優秀」。',
      },
      {
        q: '如果我的孩子在這裡適應得不好，你們通常怎麼處理？',
        why: '這題看的是學校怎麼面對「不順利」。',
        good: '說明觀察、親師討論、調整的具體流程。',
        warn: '「不會啦，每個孩子都很喜歡這裡」。',
      },
    ],
  },
];

let questionNumber = 0;
const numberedGroups = questionGroups.map((group) => ({
  ...group,
  questions: group.questions.map((item) => ({ ...item, n: ++questionNumber })),
}));

const redFlags = [
  '課表切成一堂一堂，沒有連續、由孩子自己選的工作時間',
  '分齡上課（小班、中班、大班），全班同一個進度',
  '用貼紙、集點、排名來激勵孩子',
  '說不出老師受過哪一種蒙特梭利師資訓練',
  '不讓家長入班觀察，只給看空教室或影片',
];

const compareRows = [
  '學校名稱',
  '單程通勤時間',
  '全國教保資訊網查得到？',
  '官方收費明細（已查）',
  '裁罰紀錄',
  '主教老師的蒙特梭利訓練',
  '混齡（幾歲到幾歲）',
  '每天連續工作時間',
  '一班人數／老師人數',
  '每月費用（含餐點等）',
  '一次性費用（註冊、材料…）',
  '書面退費規定？',
  '可以入班觀察？',
  '戶外時間',
  '我的直覺（1–5）',
  '孩子的反應（1–5）',
  '另一半的看法（1–5）',
];
---

<BaseLayout
  title="閱讀：蒙特梭利選校比較表＋參觀必問 20 題（2026）| BloomPath"
  description="參觀蒙特梭利幼兒園前的完整清單：教育部官方查詢步驟、20 個必問問題（附好回答與警訊）、5 個掛名蒙特梭利警訊、可列印選校比較表。"
  lang={lang}
  alternatePath={null}
>
  <Header lang={lang} altHref="/en/" />

  <main class="ebook-root">

    <!-- HEADER BAR -->
    <div class="ebook-bar">
      <div class="ebook-bar__inner">
        <a href="/zh/free/montessori-school-checklist/" class="ebook-bar__back">← 回到說明頁</a>
        <button class="ebook-bar__pdf" onclick="window.print()">🖨 列印 / 存成 PDF</button>
      </div>
    </div>

    <article class="ebook-article">

      <!-- COVER -->
      <header class="ebook-cover-section">
        <p class="ebook-eyebrow">BloomPath · 育見未來</p>
        <h1 class="ebook-title">蒙特梭利選校比較表<br />＋參觀必問 20 題</h1>
        <p class="ebook-subtitle">參觀前 10 分鐘 · 參觀時 30 分鐘 · 參觀後一個晚上</p>
        <div class="ebook-divider"></div>
        <p class="ebook-byline">整理：<strong>Mei</strong> &amp; <strong>Ethan</strong>（BloomPath）</p>
        <p class="ebook-meta">2026 年 9 月版 · 20 題 · 5 個警訊 · 可列印比較表</p>
      </header>

      <!-- HOW TO USE -->
      <section class="ebook-section">
        <h2>怎麼用這份清單</h2>
        <ol class="howto-list">
          <li><strong>參觀前：</strong>花 10 分鐘在教育部網站查 3 件事（<a href="#part-1">第 1 部分</a>）。</li>
          <li><strong>參觀時：</strong>20 題不用全問，挑你最在意的 8–10 題（<a href="#part-2">第 2 部分</a>），再對照 5 個警訊（<a href="#part-3">第 3 部分</a>）。</li>
          <li><strong>參觀後：</strong>當天晚上填比較表（<a href="#part-4">第 4 部分</a>），隔天再做決定（<a href="#part-5">第 5 部分</a>）。</li>
        </ol>
        <div class="ebook-callout">
          <strong>小提醒：</strong>好的學校不怕被問問題。對方怎麼回答，跟回答了什麼一樣重要——願意說「這個我不確定，查完再回覆你」的學校，通常比什麼都說「沒問題」的學校更可靠。
        </div>
      </section>

      <!-- PART 1 -->
      <section class="ebook-section" id="part-1">
        <p class="part-label">第 1 部分</p>
        <h2>參觀前 10 分鐘：官方查詢</h2>
        <p>教育部的「全國教保資訊網」可以查全台灣每一間立案幼兒園。參觀前先查，參觀時就能拿官方資料跟學校的說法對照。</p>

        <div class="lookup-step">
          <h3>查 1：它是立案幼兒園嗎？</h3>
          <p>到 <a href="https://ap.ece.moe.edu.tw/webecems/pubSearch.aspx" target="_blank" rel="noopener">全國教保資訊網・幼兒園查詢</a>，輸入園名或地址。查得到，就是主管機關立案的幼兒園，要符合《幼兒教育及照顧法》的師資、班級人數與收退費規定。查不到的話，參觀時直接問清楚：「你們是什麼類型的機構？」</p>
        </div>

        <div class="lookup-step">
          <h3>查 2：官方收費明細</h3>
          <p>在同一個查詢結果點進該園的詳細資料，找「收費明細」（學費、雜費、代辦費等）。參觀時拿學校的報價跟這份資料對照。</p>
        </div>

        <div class="lookup-step">
          <h3>查 3：裁罰紀錄</h3>
          <p>到 <a href="https://ap.ece.moe.edu.tw/webecems/punishSearch.aspx" target="_blank" rel="noopener">全國教保資訊網・裁罰紀錄查詢</a> 搜尋園名。有紀錄不代表現在一定不好，但參觀時可以直接問：「後來怎麼改善？」</p>
        </div>

        <div class="lookup-step">
          <h3>加分：是不是準公共幼兒園</h3>
          <p>幼兒園查詢可以篩選「準公共」類別。準公共幼兒園是跟政府合作的私立幼兒園，收費有政府規範。</p>
        </div>

        <p class="small-note">網站介面可能改版。找不到按鈕時，直接搜尋「全國教保資訊網 幼兒園查詢」。</p>
      </section>

      <!-- PART 2 -->
      <section class="ebook-section" id="part-2">
        <p class="part-label">第 2 部分</p>
        <h2>參觀必問 20 題</h2>
        <p>每題都附上<strong>為什麼要問</strong>、<span class="good-text">✓ 好的回答</span>、<span class="warn-text">⚠ 要小心的回答</span>。先圈出你最在意的 8–10 題。</p>

        {numberedGroups.map((group) => (
          <div class="q-group">
            <h3 class="q-group__title">{group.title}</h3>
            {group.questions.map((item) => (
              <div class="q-card">
                <p class="q-card__q">
                  <span class="q-card__box" aria-hidden="true"></span>
                  <span class="q-card__num">{item.n}</span>
                  <span>{item.q}</span>
                </p>
                <p class="q-card__why">{item.why}</p>
                <p class="q-card__good">✓ {item.good}</p>
                <p class="q-card__warn">⚠ {item.warn}</p>
              </div>
            ))}
          </div>
        ))}
      </section>

      <!-- PART 3 -->
      <section class="ebook-section" id="part-3">
        <p class="part-label">第 3 部分</p>
        <h2>5 個「掛名蒙特梭利」警訊</h2>
        <p>「蒙特梭利」寫在招生文宣上，不需要任何蒙特梭利組織認證。走進教室 5 分鐘，對照這 5 點：</p>
        <ul class="flag-list">
          {redFlags.map((flag) => <li>{flag}</li>)}
        </ul>
        <p>中了 1 個，多問幾句；中了 3 個以上，它可能只是「有蒙特梭利教具的傳統幼兒園」——這不一定不好，只是不值得多付「蒙特梭利」的價錢。</p>
      </section>

      <!-- PART 4 -->
      <section class="ebook-section compare-section" id="part-4">
        <p class="part-label">第 4 部分</p>
        <h2>選校比較表</h2>
        <p class="no-print">建議按上方「列印 / 存成 PDF」印出這一頁，參觀完當天晚上填。</p>
        <div class="compare-wrap">
          <table class="compare-table">
            <thead>
              <tr>
                <th scope="col">項目</th>
                <th scope="col">學校 1</th>
                <th scope="col">學校 2</th>
                <th scope="col">學校 3</th>
              </tr>
            </thead>
            <tbody>
              {compareRows.map((row) => (
                <tr>
                  <th scope="row">{row}</th>
                  <td></td>
                  <td></td>
                  <td></td>
                </tr>
              ))}
              <tr class="compare-table__total">
                <th scope="row">最後三項總分</th>
                <td></td>
                <td></td>
                <td></td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- PART 5 -->
      <section class="ebook-section" id="part-5">
        <p class="part-label">第 5 部分</p>
        <h2>參觀後：怎麼做決定</h2>
        <p>填完表，睡一晚，再問自己 3 個問題：</p>
        <ol class="decide-list">
          <li><strong>想像孩子在那間教室裡一整天，他會是什麼樣子？</strong>觀課時看到的那些孩子，就是這間學校「養出來」的樣子。</li>
          <li><strong>這個費用，我們能不能穩定負擔到畢業？</strong>把一次性費用和可能的調漲一起算，不要只看第一個月。</li>
          <li><strong>每天接送的時間，孩子和我們撐得住嗎？</strong>再好的學校，每天單程 50 分鐘也會磨掉一家人的耐心。</li>
        </ol>
        <p>沒有完美的學校。「老師怎麼看待孩子」通常比「設備多新」更重要。</p>
      </section>

      <!-- SOURCES -->
      <section class="ebook-section sources-section">
        <h2>資料來源</h2>
        <ul class="sources-list">
          <li>教育部 全國教保資訊網：<a href="https://ap.ece.moe.edu.tw/webecems/pubSearch.aspx" target="_blank" rel="noopener">幼兒園查詢</a>、<a href="https://ap.ece.moe.edu.tw/webecems/punishSearch.aspx" target="_blank" rel="noopener">裁罰紀錄查詢</a></li>
          <li><a href="https://law.moj.gov.tw/LawClass/LawSingle.aspx?pcode=H0070031&flno=16" target="_blank" rel="noopener">《幼兒教育及照顧法》第 16 條</a>（班級人數與教保服務人員配置）</li>
