---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/landing.css';

const lang = 'zh';
const appStoreUrl = 'https://apps.apple.com/tw/app/%E8%82%B2%E8%A6%8B%E6%9C%AA%E4%BE%86-bloompath/id6759791532';

const ageGroups = [
  { range: '0–1', label: '嬰兒期', desc: '建立依附關係、感官探索與動作發展的黃金期', features: ['翻身、爬行、扶站等動作里程碑', '視覺追蹤與聽覺反應', '親子依附互動記錄', '每日餵食與睡眠追蹤'] },
  { range: '1–3', label: '學步期', desc: '語言爆發、獨立探索與社交萌芽的關鍵階段', features: ['詞彙量成長追蹤', '精細與粗動作發展', '情緒辨識與表達', '蒙特梭利日常生活練習'] },
  { range: '3–6', label: '學前期', desc: '想像力、邏輯思考與同儕互動的高速發展期', features: ['數字與文字前期學習', '創意遊戲與藝術表達', '情緒調節與社交技巧', '自理能力（穿衣、如廁）'] },
  { range: '6–12', label: '學齡期', desc: '學業基礎、責任感與友誼深化的穩定成長期', features: ['學習習慣與專注力', '批判思考與問題解決', '課外技能與興趣追蹤', '家務責任與自律培養'] },
  { range: '12–18', label: '青少年期', desc: '自我認同、情緒智商與未來規劃的轉型時期', features: ['自我認同與價值觀探索', '壓力管理與情緒健康', '學業與生涯規劃支持', '親子溝通策略建議'] },
];

const features = [
  { title: '科學化發展追蹤', solves: '解決：不知道孩子發展是否正常', desc: '224 項技能指標，依照國際兒童發展標準設計，涵蓋 0–18 歲八大領域。清楚看見孩子在哪些方面領先、哪些需要多一點關注。', img: '/images/section-worry.jpg', icon: '📊' },
  { title: 'AI 育兒導師', solves: '解決：教養問題找不到可靠答案', desc: '凌晨三點也能問的育兒顧問。基於蒙特梭利方法，針對你孩子的年齡與發展狀況，給出個人化的具體建議，不是複製貼上的通用回答。', img: '/images/section-play.jpg', icon: '💬' },
  { title: '每日成長任務', solves: '解決：知道理論卻不知怎麼實踐', desc: '每天 3 個量身打造的親子活動，用 5–15 分鐘就能完成。把蒙特梭利教育理念融入日常生活，不需要特殊教具，在家就能做。', img: '/images/section-phone.jpg', icon: '✅' },
  { title: '每週成長報告', solves: '解決：成長軌跡沒有系統記錄', desc: '自動彙整一週的進展，用清晰的圖表呈現孩子的成長趨勢。不只記錄過去，更幫你看見下一步的發展方向。', img: '/images/section-bedtime.jpg', icon: '📈' },
];

const comparison = [
  { others: '只追蹤身高體重', ours: '追蹤 224 項認知與行為發展指標' },
  { others: '通用教養文章', ours: 'AI 依孩子狀況給個人化建議' },
  { others: '被動記錄', ours: '每天主動推薦成長任務' },
  { others: '只做 0–5 歲', ours: '完整涵蓋 0–18 歲八大領域' },
  { others: '英文介面', ours: '繁體中文原生設計' },
];

const testimonials = [
  { quote: '之前一直很焦慮孩子 15 個月還不太說話，用了育見未來之後，每天有具體的語言活動可以做，兩個月後詞彙量進步非常明顯。最重要的是，我自己不焦慮了，因為終於知道該怎麼幫他。', author: '陳美芳', childAge: '孩子 1 歲 7 個月', seed: 1011 },
  { quote: 'AI 導師真的很厲害，我問的問題都是很具體的情況，它給的建議不是那種書上看得到的通用回答，是真的根據我孩子的狀況來的。', author: '林俊宏', childAge: '孩子 3 歲', seed: 1022 },
  { quote: '每週報告讓我看到孩子的成長趨勢，不再只是憑感覺覺得「好像有進步」，而是真的有數據支撐。老公也開始一起追蹤了。', author: '王雅婷', childAge: '孩子 5 歲', seed: 1033 },
];

const socialProof = ['1,247 個家庭已加入候補', '蒙特梭利認可', '研究實證支持', '0–18 歲完整覆蓋', '224 項技能追蹤', 'AI 個人化育兒建議', '每天只需 5 分鐘', '繁體中文原生設計'];

const screens = [
  { title: '每日成長任務', desc: 'AI 推薦 3 個今日親子活動，5–15 分鐘完成', img: '/images/app-roadmap.png' },
  { title: '發展里程碑追蹤', desc: '清楚掌握 224 項技能進度，即時掌握成長狀況', img: '/images/app-welcome.png' },
  { title: 'AI 育兒導師', desc: '24 小時可問的育兒顧問，給出針對你孩子的具體建議', img: '/images/app-mentor.png' },
];

const ethanCredentials = [
  '10+ 年軟體工程經驗',
  '自學整合 AI 技術打造 BloomPath',
  '11 年實戰爸爸 · 蒙特梭利小學家長',
  'BloomPath 技術架構與共同創辦人',
];

const meiCredentials = [
  '11 年育兒實戰經驗',
  '蒙特梭利小學家長 · 深度參與校內方法',
  '持續實踐 Montessori 與正向教養',
  'BloomPath 共同創辦人',
];

const appleIcon = `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>`;
---

<BaseLayout
  title="育見未來 BloomPath | AI 育兒夥伴 · 0–18 歲全覆蓋"
  description="基於蒙特梭利與正向教養的 AI 育兒夥伴。224 項技能追蹤、每日成長任務、AI 育兒導師。陪伴孩子從出生到 18 歲，每一步都有科學指引。"
  lang={lang}
>
  <Header lang={lang} />

  <main class="landing-root">

    <!-- 1. HERO -->
    <section class="lp-hero">
      <div class="lp-container">
        <div class="lp-hero__grid">
          <div>
            <div class="lp-hero__badge lp-fade-up">
              <span class="lp-hero__badge-dot"></span>
              <span class="lp-hero__badge-text">App Store 已上架</span>
            </div>

            <h1 class="lp-hero__title lp-fade-up lp-delay-100">育見未來</h1>
            <p class="lp-hero__subtitle lp-fade-up lp-delay-100">BloomPath</p>

            <p class="lp-hero__lead lp-fade-up lp-delay-200">
              陪伴孩子從出生到 18 歲，<br />每一步都有科學指引。
            </p>
            <p class="lp-hero__sublead lp-fade-up lp-delay-300">
              基於蒙特梭利與正向教養的 AI 育兒夥伴
            </p>

            <div class="lp-hero__stats lp-fade-up lp-delay-400">
              <div class="lp-stat">
                <div class="lp-stat__value">224</div>
                <div class="lp-stat__label">技能指標</div>
              </div>
              <div class="lp-stat">
                <div class="lp-stat__value">0–18</div>
                <div class="lp-stat__label">歲全覆蓋</div>
              </div>
              <div class="lp-stat">
                <div class="lp-stat__value">24/7</div>
                <div class="lp-stat__label">AI 導師</div>
              </div>
            </div>

            <div class="lp-hero__cta-row lp-fade-up lp-delay-500">
              <a href={appStoreUrl} target="_blank" rel="noopener noreferrer" class="lp-btn lp-btn--primary lp-btn--large">
                <Fragment set:html={appleIcon} />
                前往 App Store 下載
              </a>
            </div>
            <p class="lp-hero__footnote">免費下載，無需信用卡。</p>
          </div>

          <div class="lp-hero__visual">
            <div class="lp-hero__visual-bg"></div>
            <img
              src="/images/ethan-mei-fullbody.png"
              alt="Ethan 與 Mei — BloomPath 共同創辦人"
              class="lp-hero__visual-img"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 2. SOCIAL PROOF -->
    <section class="lp-proof">
      <div class="lp-proof__track">
        {[...socialProof, ...socialProof].map((item) => (
          <span class="lp-proof__item">
            <span class="lp-proof__dot"></span>
            {item}
          </span>
        ))}
      </div>
    </section>

    <!-- 3. APP DEMO -->
    <section class="lp-section">
      <div class="lp-container lp-container--narrow">
        <div class="lp-section__head">
          <span class="lp-eyebrow">App Preview</span>
          <h2 class="lp-h2">每一個功能，為你而設計</h2>
          <p class="lp-body">直觀介面，讓育兒變得更有方向感。</p>
        </div>

        <div class="lp-screens">
          {screens.map((s, i) => (
            <div class={`lp-screen ${i !== 1 ? 'lp-screen--side' : ''}`}>
              <div class="lp-screen__frame"></div>
              <div class="lp-screen__inner">
                <div class="lp-screen__notch"></div>
                <img src={s.img} alt={s.title} class="lp-screen__img" loading="lazy" />
              </div>
            </div>
          ))}
        </div>

        <div class="lp-screens-captions">
          {screens.map((s) => (
            <div class="lp-screen-caption">
              <p class="lp-screen-caption__title">{s.title}</p>
              <p class="lp-screen-caption__desc">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. FEATURES -->
    <section class="lp-section lp-section--mint">
      <div class="lp-container lp-container--narrow">
        <div class="lp-section__head">
          <span class="lp-eyebrow lp-eyebrow--peach">Features</span>
          <h2 class="lp-h2">育見未來，把焦慮變成行動</h2>
        </div>

        <div class="lp-features">
          {features.map((feature, i) => (
            <div class={`lp-feature ${i % 2 === 1 ? 'lp-feature--reverse' : ''}`}>
              <div class="lp-feature__visual">
                <img src={feature.img} alt={feature.title} class="lp-feature__img" loading="lazy" />
                <div class="lp-feature__icon">{feature.icon}</div>
              </div>
              <div>
                <p class="lp-feature__solves">{feature.solves}</p>
                <h3 class="lp-feature__title">{feature.title}</h3>
                <p class="lp-feature__desc">{feature.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. MEET ETHAN & MEI -->
    <section class="lp-section lp-family">
      <div class="lp-container lp-container--narrow">
        <div class="lp-family__intro">
          <span class="lp-eyebrow lp-eyebrow--lavender">Meet the Founders</span>
          <h2 class="lp-h2">嗨，我們是 Ethan &amp; Mei</h2>
          <p class="lp-lead">
            兩個育兒 11 年的真實家長。我們的女兒就讀蒙特梭利小學。<br />
            BloomPath 是我們把這 11 年的實戰經驗、自學的 Montessori 與正向教養方法，做成你也能用的工具。
          </p>
          <p class="lp-body" style="font-size: 0.9375rem; color: var(--text-muted); margin-top: 1rem;">
            為了保護孩子隱私，我們用 AI 角色呈現。<a href="/zh/about/" style="color: var(--primary-dark); text-decoration: underline;">了解更多 →</a>
          </p>
        </div>

        <!-- Shared portrait of Ethan + Mei -->
        <div class="lp-family__portrait">
          <img src="/images/ethan-mei-fullbody.png" alt="Ethan 與 Mei — BloomPath 共同創辦人" loading="lazy" />
        </div>

        <div class="lp-family__cards">
          <!-- Ethan card -->
          <article class="lp-founder">
            <span class="lp-founder__badge">Ethan · 共同創辦人</span>
            <h3 class="lp-founder__name">Ethan</h3>
            <p class="lp-founder__role">軟體工程師 · 11 年實戰爸爸</p>
            <blockquote class="lp-founder__quote">
              「我是工程師，這 11 年看著太太每天為各種育兒問題焦慮，自己也每天在摸索。我們做 BloomPath，是把我們學過的方法跟科學研究，做成每個家長都用得上的工具——讓科學育兒不再只屬於有時間讀完一櫃書的人。」
            </blockquote>
            <ul class="lp-founder__credentials">
              {ethanCredentials.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </article>

          <!-- Mei card -->
          <article class="lp-founder">
            <span class="lp-founder__badge">Mei · 共同創辦人</span>
            <h3 class="lp-founder__name">Mei</h3>
            <p class="lp-founder__role">11 年實戰媽媽 · 蒙特梭利小學家長</p>
            <blockquote class="lp-founder__quote">
              「我不是蒙特梭利認證老師。我是一位真實家長，跟你一樣每天在育兒中犯錯、學習、再修正。女兒就讀蒙特梭利小學，這幾年我把學校的方法帶回家、自學 Daniel Siegel、Jane Nelsen、Dr. Becky 的研究。BloomPath 是我們把這 11 年的經驗整理給你，希望你不用走我們走過的彎路。」
            </blockquote>
            <ul class="lp-founder__credentials">
              {meiCredentials.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
            <div class="lp-founder__links">
              <a href="/zh/" class="lp-founder__link">看部落格</a>
              <a href="https://www.youtube.com/@bloompath" target="_blank" rel="noopener" class="lp-founder__link">YouTube 頻道</a>
              <a href="/zh/about/" class="lp-founder__link">完整故事 →</a>
            </div>
          </article>
        </div>

      </div>
    </section>

    <!-- 6. AGE NAVIGATOR -->
    <section class="lp-section">
      <div class="lp-container lp-container--narrow">
        <div class="lp-section__head lp-section__head--center">
          <span class="lp-eyebrow lp-eyebrow--rose">Age-Specific</span>
          <h2 class="lp-h2">每個年齡，都有專屬的成長地圖</h2>
          <p class="lp-body">根據孩子的年齡階段，BloomPath 自動切換最適合的追蹤內容與活動建議。</p>
        </div>

        <div class="lp-ages">
          {ageGroups.map((g) => (
            <div class="lp-age-card">
              <span class="lp-age-card__range">{g.range} 歲</span>
              <h3 class="lp-age-card__label">{g.label}</h3>
              <p class="lp-age-card__desc">{g.desc}</p>
              <ul class="lp-age-card__features">
                {g.features.map((feat) => (
                  <li>{feat}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. COMPARISON -->
    <section class="lp-section lp-section--cream-warm">
      <div class="lp-container lp-container--narrow">
        <div class="lp-section__head lp-section__head--center">
          <h2 class="lp-h2">一般育兒 App vs 育見未來</h2>
        </div>

        <div class="lp-compare">
          <div class="lp-compare__header">
            <div class="lp-compare__header-col lp-compare__header-col--left">Others</div>
            <div class="lp-compare__divider"></div>
            <div class="lp-compare__header-col lp-compare__header-col--right">BloomPath</div>
          </div>
          {comparison.map((c) => (
            <div class="lp-compare__row">
              <div class="lp-compare__cell lp-compare__cell--others">{c.others}</div>
              <div class="lp-compare__divider"></div>
              <div class="lp-compare__cell lp-compare__cell--ours">{c.ours}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 8. TESTIMONIALS -->
    <section class="lp-section">
      <div class="lp-container lp-container--narrow">
        <div class="lp-section__head">
          <span class="lp-eyebrow lp-eyebrow--rose">Testimonials</span>
          <h2 class="lp-h2">真實家長的親身體驗</h2>
        </div>

        <div class="lp-quotes">
          <div class="lp-quote lp-quote--featured">
            <p class="lp-quote__text">&ldquo;{testimonials[0].quote}&rdquo;</p>
            <div class="lp-quote__author">
              <img src={`https://picsum.photos/seed/${testimonials[0].seed}/48/48`} alt={testimonials[0].author} class="lp-quote__avatar" width="48" height="48" loading="lazy" />
              <div>
                <p class="lp-quote__name">{testimonials[0].author}</p>
                <p class="lp-quote__meta">{testimonials[0].childAge}</p>
              </div>
            </div>
          </div>

          <div class="lp-quote__stack">
            {testimonials.slice(1).map((t) => (
              <div class="lp-quote lp-quote--small">
                <p class="lp-quote__text">&ldquo;{t.quote}&rdquo;</p>
                <div class="lp-quote__author">
                  <img src={`https://picsum.photos/seed/${t.seed}/40/40`} alt={t.author} class="lp-quote__avatar" width="40" height="40" loading="lazy" />
                  <div>
                    <p class="lp-quote__name">{t.author}</p>
                    <p class="lp-quote__meta">{t.childAge}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 9. PRICING -->
    <section class="lp-section lp-section--cream-warm">
      <div class="lp-container">
        <div class="lp-section__head lp-section__head--center">
          <span class="lp-eyebrow">Pricing</span>
          <h2 class="lp-h2">選擇最適合你的方案</h2>
          <p class="lp-body">免費開始，隨時升級。</p>
        </div>

        <div class="lp-pricing">
          <div class="lp-plan">
            <p class="lp-plan__tier">免費版</p>
            <div class="lp-plan__price">
              <span class="lp-plan__amount">NT$0</span>
            </div>
            <p class="lp-plan__tagline">輕鬆入門，體驗核心功能</p>
            <ul class="lp-plan__features">
              {['追蹤 1 位孩子', '每日 1 個任務（前 3 天解鎖全部）', '每天 3 則 AI 對話', '基礎發展指標追蹤', 'Email 客服'].map((f) => (
                <li><span class="lp-plan__check">✓</span><span>{f}</span></li>
              ))}
            </ul>
            <a href={appStoreUrl} target="_blank" rel="noopener" class="lp-btn lp-btn--ghost">免費開始</a>
          </div>

          <div class="lp-plan lp-plan--pro">
            <p class="lp-plan__tier">Pro 方案</p>
            <div class="lp-plan__price">
              <span class="lp-plan__amount">NT$180</span>
              <span class="lp-plan__period">/ 月</span>
            </div>
            <p class="lp-plan__tagline">解鎖全部功能，最完整的育兒夥伴</p>
            <ul class="lp-plan__features">
              {['追蹤多位孩子（無上限）', '每日 AI 個人化任務', '無限 AI 對話', '224 項完整發展指標', '每週詳細成長報告', 'AI 睡前故事（Pro 限定）', '優先客服支援'].map((f) => (
                <li><span class="lp-plan__check">✓</span><span>{f}</span></li>
              ))}
            </ul>
            <a href={appStoreUrl} target="_blank" rel="noopener" class="lp-btn lp-btn--primary">升級 Pro</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 10. FINAL CTA -->
    <section class="lp-section lp-final">
      <div class="lp-container">
        <div class="lp-final__card">
          <div class="lp-final__logo">
            <img src="/logo-nav.png" alt="BloomPath" width="72" height="72" />
          </div>
          <h2 class="lp-final__title">立即下載育見未來</h2>
