---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/landing.css';

const lang = 'zh';
const appStoreUrl = 'https://apps.apple.com/tw/app/%E8%82%B2%E8%A6%8B%E6%9C%AA%E4%BE%86-bloompath/id6759791532';

const ageGroups = [
  { range: '0–1', label: '嬰兒期', desc: '建立依附關係、感官探索與動作發展的黃金期', features: ['翻身、爬行、扶站等動作里程碑', '視覺追蹤與聽覺反應', '親子依附互動記錄', '每日餵食與睡眠追蹤'] },
  { range: '1–3', label: '學步期', desc: '語言爆發、獨立探索與社交萌芽的關鍵階段', features: ['詞彙量成長追蹤', '精細與粗動作發展', '情緒辨識與表達', '蒙特梭利日常生活練習'] },
  { range: '3–6', label: '學前期', desc: '想像力、邏輯思考與同儕互動的高速發展期', features: ['數字與文字前期學習', '創意遊戲與藝術表達', '情緒調節與社交技巧', '自理能力（穿衣、如廁）'] },
  { range: '6–12', label: '學齡期', desc: '學業基礎、責任感與友誼深化的穩定成長期', features: ['學習習慣與專注力', '批判思考與問題解決', '課外技能與興趣追蹤', '家務責任與自律培養'] },
  { range: '12–18', label: '青少年期', desc: '自我認同、情緒智商與未來規劃的轉型時期', features: ['自我認同與價值觀探索', '壓力管理與情緒健康', '學業與生涯規劃支持', '親子溝通策略建議'] },
];

const features = [
  { title: '科學化發展追蹤', solves: '解決：不知道孩子發展是否正常', desc: '224 項技能指標，依照國際兒童發展標準設計，涵蓋 0–18 歲八大領域。清楚看見孩子在哪些方面領先、哪些需要多一點關注。', img: '/images/section-worry.jpg', icon: '📊' },
  { title: 'AI 育兒導師', solves: '解決：教養問題找不到可靠答案', desc: '凌晨三點也能問的育兒顧問。基於蒙特梭利方法，針對你孩子的年齡與發展狀況，給出個人化的具體建議，不是複製貼上的通用回答。', img: '/images/section-play.jpg', icon: '💬' },
  { title: '每日成長任務', solves: '解決：知道理論卻不知怎麼實踐', desc: '每天 3 個量身打造的親子活動，用 5–15 分鐘就能完成。把蒙特梭利教育理念融入日常生活，不需要特殊教具，在家就能做。', img: '/images/section-phone.jpg', icon: '✅' },
  { title: '每週成長報告', solves: '解決：成長軌跡沒有系統記錄', desc: '自動彙整一週的進展，用清晰的圖表呈現孩子的成長趨勢。不只記錄過去，更幫你看見下一步的發展方向。', img: '/images/section-bedtime.jpg', icon: '📈' },
];

const comparison = [
  { others: '只追蹤身高體重', ours: '追蹤 224 項認知與行為發展指標' },
  { others: '通用教養文章', ours: 'AI 依孩子狀況給個人化建議' },
  { others: '被動記錄', ours: '每天主動推薦成長任務' },
  { others: '只做 0-5 歲', ours: '完整涵蓋 0-18 歲八大領域' },
  { others: '英文介面', ours: '繁體中文原生設計' },
];

const testimonials = [
  { quote: '之前一直很焦慮孩子 15 個月還不太說話，用了育見未來之後，每天有具體的語言活動可以做，兩個月後詞彙量進步非常明顯。最重要的是，我自己不焦慮了，因為終於知道該怎麼幫他。', author: '陳美芳', childAge: '孩子 1 歲 7 個月', seed: 1011 },
  { quote: 'AI 導師真的很厲害，我問的問題都是很具體的情況，它給的建議不是那種書上看得到的通用回答，是真的根據我孩子的狀況來的。', author: '林俊宏', childAge: '孩子 3 歲', seed: 1022 },
  { quote: '每週報告讓我看到孩子的成長趨勢，不再只是憑感覺覺得「好像有進步」，而是真的有數據支撐。老公也開始一起追蹤了。', author: '王雅婷', childAge: '孩子 5 歲', seed: 1033 },
];

const socialProof = ['1,247 個家庭已加入候補', '蒙特梭利認可', '研究實證支持', '0–18 歲完整覆蓋', '224 項技能追蹤', 'AI 個人化育兒建議', '每天只需 5 分鐘', '繁體中文原生設計'];

const screens = [
  { title: '每日成長任務', desc: 'AI 推薦 3 個今日親子活動，5–15 分鐘完成', img: '/images/app-roadmap.png' },
  { title: '發展里程碑追蹤', desc: '清楚掌握 224 項技能進度，即時掌握成長狀況', img: '/images/app-welcome.png' },
  { title: 'AI 育兒導師', desc: '24 小時可問的育兒顧問，給出針對你孩子的具體建議', img: '/images/app-mentor.png' },
];
---

<BaseLayout
  title="育見未來 BloomPath | AI 育兒夥伴 · 0–18 歲全覆蓋"
  description="基於蒙特梭利與正向教養的 AI 育兒夥伴。224 項技能追蹤、每日成長任務、AI 育兒導師。陪伴孩子從出生到 18 歲，每一步都有科學指引。"
  lang={lang}
>
  <Header lang={lang} />

  <main class="landing-root min-h-screen overflow-x-hidden">

    <!-- 1. HERO -->
    <section class="relative min-h-[100dvh] flex items-center overflow-hidden">
      <div class="absolute inset-0">
        <img src="/images/hero-zh.jpg" alt="" class="w-full h-full object-cover object-center" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-[#FBF8F4]/90 via-[#FBF8F4]/75 to-[#FBF8F4]/40 lg:to-transparent"></div>
      </div>

      <div class="blob blob-animate absolute -top-20 -right-20 w-[500px] h-[500px] bg-mint/20 blur-3xl"></div>
      <div class="blob blob-animate absolute -bottom-32 -left-32 w-[600px] h-[600px] bg-peach/15 blur-3xl" style="animation-delay: -3s"></div>

      <div class="relative w-full max-w-7xl mx-auto px-6 lg:px-12 py-20 lg:py-0">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div class="max-w-xl">
            <div class="inline-flex items-center gap-2 bg-white/80 backdrop-blur-sm border border-primary/20 rounded-full px-5 py-2 mb-8 animate-fade-up shadow-sm">
              <div class="w-2.5 h-2.5 rounded-full bg-primary animate-pulse-dot"></div>
              <span class="text-xs font-extrabold text-primary-dark tracking-wide uppercase">立即下載</span>
            </div>

            <h1 class="mb-6 animate-fade-up delay-100">
              <span class="block text-5xl md:text-6xl lg:text-7xl font-extrabold text-text tracking-tighter leading-[0.95] mb-4">育見未來</span>
              <span class="block text-lg md:text-xl text-primary-dark font-bold tracking-widest uppercase">BloomPath</span>
            </h1>

            <p class="text-xl md:text-2xl font-bold text-text/80 leading-relaxed mb-2 animate-fade-up delay-200">
              陪伴孩子從出生到 18 歲，<br/>每一步都有科學指引。
            </p>
            <p class="text-base text-text-muted mb-10 animate-fade-up delay-300">
              基於蒙特梭利與正向教養的 AI 育兒夥伴
            </p>

            <div class="flex gap-3 mb-10 animate-fade-up delay-400">
              <div class="bg-white/90 backdrop-blur-sm border border-border/50 rounded-2xl px-5 py-3 text-center shadow-sm">
                <div class="text-2xl font-extrabold text-text tracking-tighter">224</div>
                <div class="text-xs text-text-muted font-medium">技能指標</div>
              </div>
              <div class="bg-white/90 backdrop-blur-sm border border-border/50 rounded-2xl px-5 py-3 text-center shadow-sm">
                <div class="text-2xl font-extrabold text-text tracking-tighter">0–18</div>
                <div class="text-xs text-text-muted font-medium">歲全覆蓋</div>
              </div>
            </div>

            <div class="animate-fade-up delay-500">
              <a href={appStoreUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-primary text-white rounded-full px-10 py-5 text-lg font-extrabold hover:bg-primary-dark hover:scale-105 transition-all duration-300 shadow-[0_8px_30px_-6px_rgba(139,181,162,0.5)]">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
                前往 App Store 下載
              </a>
              <p class="text-sm text-text-muted mt-4">免費下載，無需信用卡。</p>
            </div>
          </div>

          <div class="hidden lg:flex items-center justify-center relative animate-fade-up delay-300">
            <div class="absolute w-[320px] h-[320px] rounded-full bg-gradient-to-br from-mint/50 to-lavender/30 blur-sm"></div>
            <div class="relative animate-float" style="width: 200px; height: 400px">
              <div class="absolute inset-0 rounded-[36px] bg-stone-800 shadow-[0_32px_64px_-16px_rgba(74,69,67,0.35)]"></div>
              <div class="absolute inset-[3px] rounded-[33px] bg-stone-900 overflow-hidden">
                <div class="absolute top-2.5 left-1/2 -translate-x-1/2 w-16 h-4 bg-stone-900 rounded-full z-20"></div>
                <div class="absolute inset-0 rounded-[30px] overflow-hidden">
                  <img src="/images/app-roadmap.png" alt="BloomPath app preview" class="w-full h-full object-cover object-top" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. SOCIAL PROOF -->
    <section class="py-5 bg-white/60 border-y border-border/50 overflow-hidden">
      <div class="flex animate-marquee whitespace-nowrap">
        {[...socialProof, ...socialProof].map((item) => (
          <span class="inline-flex items-center gap-2 mx-6 text-sm text-text-secondary font-semibold shrink-0">
            <span class="w-1.5 h-1.5 rounded-full bg-primary shrink-0"></span>
            {item}
          </span>
        ))}
      </div>
    </section>

    <!-- 3. APP DEMO -->
    <section class="py-20 md:py-28 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="mb-14">
          <span class="inline-block text-xs font-bold text-primary-dark bg-primary/10 rounded-full px-4 py-1.5 mb-4 tracking-wide uppercase">App Preview</span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-text tracking-tighter mb-3">每一個功能，為你而設計</h2>
          <p class="text-text-secondary max-w-md">直觀介面，讓育兒變得更有方向感</p>
        </div>

        <div class="flex flex-col items-center gap-10">
          <div class="grid grid-cols-3 gap-4 md:gap-8 max-w-3xl w-full">
            {screens.map((s, i) => (
              <div class={`${i === 1 ? 'scale-100 z-10' : 'scale-90 opacity-70'} transition-all`}>
                <div class="relative mx-auto" style="aspect-ratio: 1/2; max-width: 200px">
                  <div class="absolute inset-0 rounded-[28px] bg-stone-800 shadow-xl"></div>
                  <div class="absolute inset-[3px] rounded-[26px] bg-stone-900 overflow-hidden">
                    <div class="absolute top-2 left-1/2 -translate-x-1/2 w-12 h-3 bg-stone-900 rounded-full z-20"></div>
                    <img src={s.img} alt={s.title} class="w-full h-full object-cover object-top" loading="lazy" />
                  </div>
                </div>
              </div>
            ))}
          </div>

          <div class="grid md:grid-cols-3 gap-6 max-w-3xl w-full">
            {screens.map((s) => (
              <div class="text-center">
                <p class="font-bold text-text mb-1">{s.title}</p>
                <p class="text-sm text-text-muted">{s.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 4. FEATURES -->
    <section class="py-20 md:py-28 section-mint">
      <div class="max-w-5xl mx-auto px-6">
        <div class="mb-14">
          <span class="inline-block text-xs font-bold text-secondary bg-secondary/10 rounded-full px-4 py-1.5 mb-4 tracking-wide uppercase">Features</span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-text tracking-tighter">育見未來，幫你把焦慮變成行動</h2>
        </div>

        <div class="space-y-16">
          {features.map((feature, i) => (
            <div class={`grid md:grid-cols-2 gap-8 items-center ${i % 2 === 1 ? 'md:[direction:rtl]' : ''}`}>
              <div class={`relative rounded-3xl overflow-hidden min-h-[260px] ${i % 2 === 1 ? 'md:[direction:ltr]' : ''}`}>
                <img src={feature.img} alt="" class="w-full h-full object-cover absolute inset-0" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
                <div class="absolute bottom-4 left-4 w-12 h-12 rounded-2xl bg-white/90 backdrop-blur-sm flex items-center justify-center shadow-sm text-xl">{feature.icon}</div>
              </div>
              <div class={i % 2 === 1 ? 'md:[direction:ltr]' : ''}>
                <p class="text-xs font-bold text-secondary uppercase tracking-wide mb-3">{feature.solves}</p>
                <h3 class="text-2xl font-extrabold text-text tracking-tight mb-3">{feature.title}</h3>
                <p class="text-text-secondary leading-relaxed">{feature.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4.5 MEET MEI -->
    <section class="py-20 md:py-28 section-lavender relative overflow-hidden">
      <div class="blob blob-animate absolute -top-20 -right-20 w-[400px] h-[400px] bg-lavender/30 blur-3xl"></div>
      <div class="blob blob-animate absolute -bottom-20 -left-20 w-[400px] h-[400px] bg-peach/25 blur-3xl" style="animation-delay: -4s"></div>

      <div class="max-w-5xl mx-auto px-6 relative">
        <div class="grid md:grid-cols-[auto_1fr] gap-10 md:gap-14 items-center">
          <div class="flex justify-center md:justify-start">
            <div class="relative">
              <div class="absolute inset-0 bg-gradient-to-br from-primary/30 to-lavender/40 rounded-full blur-2xl scale-110"></div>
              <div class="relative w-56 h-56 md:w-64 md:h-64 rounded-full overflow-hidden border-4 border-white shadow-[0_20px_50px_-15px_rgba(139,181,162,0.4)]">
                <img src="/images/mei-avatar.png" alt="Mei — BloomPath Mentor" class="w-full h-full object-cover" />
              </div>
            </div>
          </div>

          <div>
            <span class="inline-block text-xs font-extrabold text-primary-dark bg-primary/15 rounded-full px-4 py-1.5 mb-4 tracking-wide uppercase">認識你的育兒夥伴</span>
            <h2 class="text-3xl md:text-4xl font-extrabold text-text tracking-tighter mb-3">嗨，我是 Mei</h2>
            <p class="text-base text-primary-dark font-semibold mb-6">蒙特梭利老師 · Luna（2 歲半）的媽媽 · 你的 AI 育兒夥伴</p>
            <blockquote class="text-text-secondary leading-relaxed mb-6 pl-4 border-l-4 border-primary/30 italic">
              &ldquo;在 Luna 出生之前，我當了 6 年的蒙特梭利老師。現在我也是媽媽，跟你一樣每天都在摸索育兒的各種問題。我做 BloomPath，是想給你當年我最希望有的東西：基於兒童發展科學、真正用得上的建議。&rdquo;
            </blockquote>
            <ul class="space-y-2 mb-8">
              {['蒙特梭利認證教師（AMS/AMI）', 'BloomPath YouTube 頻道主持人', 'bloom-path.app 部落格作者', '現居峇里島，雙語教養 Luna（中/英）'].map((c) => (
                <li class="flex items-start gap-2 text-sm text-text-secondary">
                  <span class="text-primary-dark mt-1 shrink-0">✓</span>
                  <span>{c}</span>
                </li>
              ))}
            </ul>
            <div class="flex flex-wrap gap-3">
              <a href="/zh/" class="inline-flex items-center gap-2 bg-white border-2 border-primary/40 text-primary-dark rounded-full px-5 py-2.5 text-sm font-bold hover:bg-primary/5 transition-colors">看 Mei 的部落格 →</a>
              <a href="https://www.youtube.com/@bloompath" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-white border-2 border-border text-text rounded-full px-5 py-2.5 text-sm font-bold hover:bg-cream transition-colors">到 YouTube 看影片 →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. AGE NAVIGATOR -->
    <section class="py-20 md:py-28 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="mb-10 text-center">
          <span class="inline-block text-xs font-bold text-accent bg-accent/20 rounded-full px-4 py-1.5 mb-4 tracking-wide uppercase">Age-Specific</span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-text tracking-tighter mb-3">每個年齡，都有專屬的成長地圖</h2>
          <p class="text-text-secondary max-w-xl mx-auto">根據孩子的年齡階段，BloomPath 自動切換最適合的追蹤內容與活動建議</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
          {ageGroups.map((g) => (
            <div class="bg-white/80 rounded-3xl p-6 border border-border/50">
              <div class="inline-block bg-primary/12 text-primary-dark text-xs font-bold rounded-full px-3 py-1 mb-3">{g.range} 歲</div>
              <h3 class="text-xl font-extrabold text-text mb-2">{g.label}</h3>
              <p class="text-sm text-text-secondary leading-relaxed mb-4">{g.desc}</p>
              <ul class="space-y-2">
                {g.features.map((feat) => (
                  <li class="flex items-start gap-2">
                    <span class="text-primary-dark mt-0.5 shrink-0 text-sm">✓</span>
                    <span class="text-sm text-text-secondary">{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. COMPARISON -->
    <section class="py-20 md:py-28 bg-white/40 px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-extrabold text-text tracking-tighter text-center mb-12">一般育兒 App vs 育見未來</h2>
        <div class="rounded-3xl overflow-hidden border border-border/50 bg-white shadow-[0_20px_40px_-15px_rgba(74,69,67,0.08)]">
          <div class="grid grid-cols-[1fr_auto_1fr] bg-cream/60 border-b border-border/50">
            <div class="px-6 py-4 text-sm font-bold text-text-muted text-center">Others</div>
            <div class="w-px bg-border/50"></div>
            <div class="px-6 py-4 text-sm font-bold text-primary-dark text-center">BloomPath</div>
          </div>
          {comparison.map((c, i) => (
            <div class={`grid grid-cols-[1fr_auto_1fr] ${i < comparison.length - 1 ? 'border-b border-border/30' : ''}`}>
              <div class="px-6 py-4 text-sm text-text-muted text-right line-through decoration-text-muted/40">{c.others}</div>
              <div class="w-px bg-border/30 my-3"></div>
              <div class="px-6 py-4 text-sm text-text font-semibold">{c.ours}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. TESTIMONIALS -->
    <section class="py-20 md:py-28 px-6">
      <div class="max-w-5xl mx-auto">
        <div class="mb-12">
          <span class="inline-block text-xs font-bold text-accent bg-accent/20 rounded-full px-4 py-1.5 mb-4 tracking-wide uppercase">Testimonials</span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-text tracking-tighter">真實家長的親身體驗</h2>
        </div>

        <div class="grid md:grid-cols-[5fr_4fr] gap-5">
          <div class="bg-white rounded-3xl p-8 border border-border/50 shadow-[0_20px_40px_-15px_rgba(74,69,67,0.07)] flex flex-col justify-between">
            <p class="text-text-secondary leading-relaxed text-base mb-6">&ldquo;{testimonials[0].quote}&rdquo;</p>
            <div class="flex items-center gap-3">
