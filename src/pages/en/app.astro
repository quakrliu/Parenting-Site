---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/landing.css';

const lang = 'en';
const appStoreUrl = 'https://apps.apple.com/us/app/bloompath/id6759791532';

const ageGroups = [
  { range: '0–1', label: 'Infant', desc: 'Golden window for attachment, sensory exploration, and motor development.', features: ['Motor milestones (rolling, crawling, standing)', 'Visual tracking & auditory response', 'Parent-child attachment logging', 'Daily feeding & sleep tracking'] },
  { range: '1–3', label: 'Toddler', desc: 'Language explosion, independent exploration, and budding social skills.', features: ['Vocabulary growth tracking', 'Fine & gross motor development', 'Emotion recognition & expression', 'Montessori practical-life activities'] },
  { range: '3–6', label: 'Preschool', desc: 'Rapid growth in imagination, logical thinking, and peer interaction.', features: ['Pre-literacy & pre-numeracy', 'Creative play & art expression', 'Emotion regulation & social skills', 'Self-care (dressing, toileting)'] },
  { range: '6–12', label: 'School-age', desc: 'Building academic foundations, responsibility, and deepening friendships.', features: ['Study habits & focus', 'Critical thinking & problem solving', 'Extracurricular skills & interests', 'Chores & self-discipline'] },
  { range: '12–18', label: 'Teen', desc: 'Identity formation, emotional intelligence, and future planning.', features: ['Identity & values exploration', 'Stress & emotional health', 'Academic & career planning', 'Parent-teen communication scripts'] },
];

const features = [
  { title: 'Science-based development tracking', solves: 'Solves: not sure if your child is on track', desc: '224 skill indicators designed to international child-development standards, covering 8 domains from birth to 18. See clearly where your child is ahead and where they need a little extra attention.', img: '/images/section-worry.jpg', icon: '📊' },
  { title: 'AI parenting mentor', solves: "Solves: can't find reliable answers", desc: "A 3 AM parenting expert you can actually ask. Grounded in Montessori practice, personalized to your child's age and development — not the same generic advice you find everywhere else.", img: '/images/section-play.jpg', icon: '💬' },
  { title: 'Daily growth tasks', solves: 'Solves: you know the theory but not how to apply it', desc: 'Three custom parent-child activities every day, each 5–15 minutes. Brings Montessori principles into daily life with materials you already have at home.', img: '/images/section-phone.jpg', icon: '✅' },
  { title: 'Weekly growth report', solves: "Solves: no real record of your child's journey", desc: "Auto-summarized weekly progress with clear charts showing your child's growth trends. Not just looking back — pointing to the next step.", img: '/images/section-bedtime.jpg', icon: '📈' },
];

const comparison = [
  { others: 'Tracks only height & weight', ours: 'Tracks 224 cognitive & behavioral indicators' },
  { others: 'Generic parenting articles', ours: 'AI advice personalized to your child' },
  { others: 'Passive logging', ours: 'Active daily growth-task suggestions' },
  { others: 'Only 0–5 years', ours: 'Complete 0–18 coverage, 8 domains' },
  { others: 'English-only UI', ours: 'Truly bilingual (English + Traditional Chinese)' },
];

const testimonials = [
  { quote: "I was so anxious my 15-month-old wasn't talking much. After using BloomPath I had concrete language activities every day, and his vocabulary improved noticeably within two months. The biggest difference was that I stopped panicking — I finally knew how to help him.", author: 'Sarah Chen', childAge: 'Child age 1 yr 7 mo', seed: 1011 },
  { quote: "The AI mentor is genuinely useful. I ask about very specific situations and the advice isn't the cookie-cutter stuff you read in books — it's actually grounded in my child's context.", author: 'Justin Lin', childAge: 'Child age 3', seed: 1022 },
  { quote: "The weekly reports let me see my daughter's growth trends instead of guessing. Now my husband tracks alongside me too.", author: 'Yating Wang', childAge: 'Child age 5', seed: 1033 },
];

const socialProof = ['1,247 families on waitlist', 'Montessori-aligned', 'Research-backed', '0–18 full coverage', '224 skill indicators', 'Personalized AI advice', '5 minutes a day', 'Bilingual EN / 繁中'];

const screens = [
  { title: 'Daily growth tasks', desc: 'AI picks 3 parent-child activities for today, 5–15 minutes each.', img: '/images/app-roadmap-en.png' },
  { title: 'Milestone tracking', desc: "See your child's progress across 224 skills in real time.", img: '/images/app-welcome-en.png' },
  { title: 'AI parenting mentor', desc: 'A 24/7 expert who gives you advice specific to your child.', img: '/images/app-mentor-en.png' },
];

const ethanCredentials = [
  '10+ years software engineering',
  'AI / ML background in Silicon Valley',
  'BloomPath technical architect',
  'A new dad — still learning every day',
];

const meiCredentials = [
  'Certified Montessori teacher (AMS / AMI)',
  '6 years teaching in Montessori preschools',
  'Host of the BloomPath YouTube channel',
  'Raising Luna bilingually (English / Chinese)',
];

const appleIcon = `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>`;
---

<BaseLayout
  title="BloomPath | AI Parenting Companion · Birth to 18"
  description="An AI-powered parenting companion grounded in Montessori and positive parenting. 224 skill indicators, daily growth tasks, and a 24/7 AI mentor — birth to 18, every step backed by science."
  lang={lang}
>
  <Header lang={lang} />

  <main class="landing-root">

    <!-- 1. HERO -->
    <section class="lp-hero">
      <div class="lp-container">
        <div class="lp-hero__grid">
          <div>
            <div class="lp-hero__badge lp-fade-up">
              <span class="lp-hero__badge-dot"></span>
              <span class="lp-hero__badge-text">Now on the App Store</span>
            </div>

            <h1 class="lp-hero__title lp-fade-up lp-delay-100">BloomPath</h1>
            <p class="lp-hero__subtitle lp-fade-up lp-delay-100">育見未來</p>

            <p class="lp-hero__lead lp-fade-up lp-delay-200">
              Every step from birth to 18,<br />backed by science.
            </p>
            <p class="lp-hero__sublead lp-fade-up lp-delay-300">
              An AI parenting companion built on Montessori &amp; positive parenting
            </p>

            <div class="lp-hero__stats lp-fade-up lp-delay-400">
              <div class="lp-stat">
                <div class="lp-stat__value">224</div>
                <div class="lp-stat__label">skill indicators</div>
              </div>
              <div class="lp-stat">
                <div class="lp-stat__value">0–18</div>
                <div class="lp-stat__label">full coverage</div>
              </div>
              <div class="lp-stat">
                <div class="lp-stat__value">24/7</div>
                <div class="lp-stat__label">AI mentor</div>
              </div>
            </div>

            <div class="lp-hero__cta-row lp-fade-up lp-delay-500">
              <a href={appStoreUrl} target="_blank" rel="noopener noreferrer" class="lp-btn lp-btn--primary lp-btn--large">
                <Fragment set:html={appleIcon} />
                Download on the App Store
              </a>
            </div>
            <p class="lp-hero__footnote">Free to download — no credit card required.</p>
          </div>

          <div class="lp-hero__visual">
            <div class="lp-hero__visual-bg"></div>
            <img
              src="/images/ethan-mei-luna-family.png"
              alt="Ethan, Mei, and Luna — the family behind BloomPath"
              class="lp-hero__visual-img"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 2. SOCIAL PROOF -->
    <section class="lp-proof">
      <div class="lp-proof__track">
        {[...socialProof, ...socialProof].map((item) => (
          <span class="lp-proof__item">
            <span class="lp-proof__dot"></span>
            {item}
          </span>
        ))}
      </div>
    </section>

    <!-- 3. APP DEMO -->
    <section class="lp-section">
      <div class="lp-container lp-container--narrow">
        <div class="lp-section__head">
          <span class="lp-eyebrow">App Preview</span>
          <h2 class="lp-h2">Every feature, designed for you</h2>
          <p class="lp-body">An interface that turns parenting from guesswork into direction.</p>
        </div>

        <div class="lp-screens">
          {screens.map((s, i) => (
            <div class={`lp-screen ${i !== 1 ? 'lp-screen--side' : ''}`}>
              <div class="lp-screen__frame"></div>
              <div class="lp-screen__inner">
                <div class="lp-screen__notch"></div>
                <img src={s.img} alt={s.title} class="lp-screen__img" loading="lazy" />
              </div>
            </div>
          ))}
        </div>

        <div class="lp-screens-captions">
          {screens.map((s) => (
            <div class="lp-screen-caption">
              <p class="lp-screen-caption__title">{s.title}</p>
              <p class="lp-screen-caption__desc">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. FEATURES -->
    <section class="lp-section lp-section--mint">
      <div class="lp-container lp-container--narrow">
        <div class="lp-section__head">
          <span class="lp-eyebrow lp-eyebrow--peach">Features</span>
          <h2 class="lp-h2">BloomPath turns parenting anxiety into action</h2>
        </div>

        <div class="lp-features">
          {features.map((feature, i) => (
            <div class={`lp-feature ${i % 2 === 1 ? 'lp-feature--reverse' : ''}`}>
              <div class="lp-feature__visual">
                <img src={feature.img} alt={feature.title} class="lp-feature__img" loading="lazy" />
                <div class="lp-feature__icon">{feature.icon}</div>
              </div>
              <div>
                <p class="lp-feature__solves">{feature.solves}</p>
                <h3 class="lp-feature__title">{feature.title}</h3>
                <p class="lp-feature__desc">{feature.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. MEET ETHAN & MEI -->
    <section class="lp-section lp-family">
      <div class="lp-container lp-container--narrow">
        <div class="lp-family__intro">
          <span class="lp-eyebrow lp-eyebrow--lavender">Meet the Founders</span>
          <h2 class="lp-h2">Hi, we're Ethan &amp; Mei</h2>
          <p class="lp-lead">
            One engineer, one Montessori teacher, and a 2½-year-old named Luna.<br />
            BloomPath is how we turned our expertise — and our daily parenting practice — into something you can use too.
          </p>
        </div>

        <!-- Shared portrait of Ethan + Mei -->
        <div class="lp-family__portrait">
          <img src="/images/ethan-mei-fullbody.png" alt="Ethan and Mei — BloomPath co-founders" loading="lazy" />
        </div>

        <div class="lp-family__cards">
          <!-- Ethan card -->
          <article class="lp-founder">
            <span class="lp-founder__badge">Ethan · Co-founder</span>
            <h3 class="lp-founder__name">Ethan</h3>
            <p class="lp-founder__role">Software engineer · Luna's dad</p>
            <blockquote class="lp-founder__quote">
              "Mei is the parenting expert. I'm the engineer who watched her wrestle with the same parenting questions every day. We built BloomPath to turn her expertise into a tool every parent can actually use — so science-based parenting isn't just for the lucky few."
            </blockquote>
            <ul class="lp-founder__credentials">
              {ethanCredentials.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
          </article>

          <!-- Mei card -->
          <article class="lp-founder">
            <span class="lp-founder__badge">Mei · Co-founder</span>
            <h3 class="lp-founder__name">Mei</h3>
            <p class="lp-founder__role">Montessori teacher · Luna's mom</p>
            <blockquote class="lp-founder__quote">
              "Before Luna was born, I taught Montessori for 6 years. Now I'm a mom too, working through the same parenting questions you are. BloomPath is the thing I wish I'd had: real child-development science, distilled into advice that actually fits your day."
            </blockquote>
            <ul class="lp-founder__credentials">
              {meiCredentials.map((c) => (
                <li>{c}</li>
              ))}
            </ul>
            <div class="lp-founder__links">
              <a href="/en/" class="lp-founder__link">Read Mei's blog</a>
              <a href="https://www.youtube.com/@bloompath" target="_blank" rel="noopener" class="lp-founder__link">YouTube channel</a>
            </div>
          </article>
        </div>

        <!-- Luna mention -->
        <div class="lp-family__luna">
          <div class="lp-family__luna-avatar">
            <img src="/images/luna-avatar.png" alt="Luna" loading="lazy" />
          </div>
          <p class="lp-family__luna-text">
            <strong>Luna (2½)</strong> — the inspiration behind BloomPath, and our daily QA tester.
            Every task and every suggestion in the app gets tried on her first.
          </p>
        </div>
      </div>
    </section>

    <!-- 6. AGE NAVIGATOR -->
    <section class="lp-section">
      <div class="lp-container lp-container--narrow">
        <div class="lp-section__head lp-section__head--center">
          <span class="lp-eyebrow lp-eyebrow--rose">Age-Specific</span>
          <h2 class="lp-h2">A growth map for every age</h2>
          <p class="lp-body">BloomPath automatically adapts to your child's stage — tracking what matters and recommending what fits.</p>
        </div>

        <div class="lp-ages">
          {ageGroups.map((g) => (
            <div class="lp-age-card">
              <span class="lp-age-card__range">{g.range} yrs</span>
              <h3 class="lp-age-card__label">{g.label}</h3>
              <p class="lp-age-card__desc">{g.desc}</p>
              <ul class="lp-age-card__features">
                {g.features.map((feat) => (
                  <li>{feat}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. COMPARISON -->
    <section class="lp-section lp-section--cream-warm">
      <div class="lp-container lp-container--narrow">
        <div class="lp-section__head lp-section__head--center">
          <h2 class="lp-h2">Typical parenting apps vs BloomPath</h2>
        </div>

        <div class="lp-compare">
          <div class="lp-compare__header">
            <div class="lp-compare__header-col lp-compare__header-col--left">Others</div>
            <div class="lp-compare__divider"></div>
            <div class="lp-compare__header-col lp-compare__header-col--right">BloomPath</div>
          </div>
          {comparison.map((c) => (
            <div class="lp-compare__row">
              <div class="lp-compare__cell lp-compare__cell--others">{c.others}</div>
              <div class="lp-compare__divider"></div>
              <div class="lp-compare__cell lp-compare__cell--ours">{c.ours}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 8. TESTIMONIALS -->
    <section class="lp-section">
      <div class="lp-container lp-container--narrow">
        <div class="lp-section__head">
          <span class="lp-eyebrow lp-eyebrow--rose">Testimonials</span>
          <h2 class="lp-h2">Real parents, real change</h2>
        </div>

        <div class="lp-quotes">
          <div class="lp-quote lp-quote--featured">
            <p class="lp-quote__text">&ldquo;{testimonials[0].quote}&rdquo;</p>
            <div class="lp-quote__author">
              <img src={`https://picsum.photos/seed/${testimonials[0].seed}/48/48`} alt={testimonials[0].author} class="lp-quote__avatar" width="48" height="48" loading="lazy" />
              <div>
                <p class="lp-quote__name">{testimonials[0].author}</p>
                <p class="lp-quote__meta">{testimonials[0].childAge}</p>
              </div>
            </div>
          </div>

          <div class="lp-quote__stack">
            {testimonials.slice(1).map((t) => (
              <div class="lp-quote lp-quote--small">
                <p class="lp-quote__text">&ldquo;{t.quote}&rdquo;</p>
                <div class="lp-quote__author">
                  <img src={`https://picsum.photos/seed/${t.seed}/40/40`} alt={t.author} class="lp-quote__avatar" width="40" height="40" loading="lazy" />
                  <div>
                    <p class="lp-quote__name">{t.author}</p>
                    <p class="lp-quote__meta">{t.childAge}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 9. PRICING -->
    <section class="lp-section lp-section--cream-warm">
      <div class="lp-container">
        <div class="lp-section__head lp-section__head--center">
          <span class="lp-eyebrow">Pricing</span>
          <h2 class="lp-h2">Pick the plan that fits</h2>
          <p class="lp-body">Start free. Upgrade whenever you're ready.</p>
        </div>

        <div class="lp-pricing">
          <div class="lp-plan">
            <p class="lp-plan__tier">Free</p>
            <div class="lp-plan__price">
              <span class="lp-plan__amount">$0</span>
            </div>
            <p class="lp-plan__tagline">Easy on-ramp — try the core features</p>
            <ul class="lp-plan__features">
              {['Track 1 child', '1 daily task (full unlock first 3 days)', '3 AI messages a day', 'Core development tracking', 'Email support'].map((f) => (
                <li><span class="lp-plan__check">✓</span><span>{f}</span></li>
              ))}
            </ul>
            <a href={appStoreUrl} target="_blank" rel="noopener" class="lp-btn lp-btn--ghost">Start free</a>
          </div>

          <div class="lp-plan lp-plan--pro">
            <p class="lp-plan__tier">Pro</p>
            <div class="lp-plan__price">
              <span class="lp-plan__amount">$5.99</span>
              <span class="lp-plan__period">/ month</span>
            </div>
            <p class="lp-plan__tagline">Unlock everything, for the whole family</p>
            <ul class="lp-plan__features">
              {['Track unlimited children', 'Daily AI-personalized tasks', 'Unlimited AI mentor chat', 'All 224 development indicators', 'Detailed weekly growth reports', 'AI bedtime stories (Pro only)', 'Priority support'].map((f) => (
                <li><span class="lp-plan__check">✓</span><span>{f}</span></li>
              ))}
            </ul>
            <a href={appStoreUrl} target="_blank" rel="noopener" class="lp-btn lp-btn--primary">Upgrade to Pro</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 10. FINAL CTA -->
    <section class="lp-section lp-final">
      <div class="lp-container">
        <div class="lp-final__card">
          <div class="lp-final__logo">
            <img src="/logo-nav.png" alt="BloomPath" width="72" height="72" />
          </div>
          <h2 class="lp-final__title">Download BloomPath today</h2>
          <p class="lp-final__desc">Available on the App Store — start your child's growth journey.</p>
          <a href={appStoreUrl} target="_blank" rel="noopener" class="lp-btn lp-btn--dark lp-btn--large">
            <Fragment set:html={appleIcon} />
            Download on the App Store
          </a>
          <p class="lp-final__footnote">Free to download — no credit card required.</p>
        </div>
      </div>
    </section>

  </main>

  <Footer lang={lang} />
</BaseLayout>
