---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../../i18n/utils';
const lang = 'en'; const t = useTranslations(lang);
const allPosts = await getCollection("blog"); const now = new Date();
const posts = allPosts.filter((post) => post.data.pubDate <= now && post.data.lang === "en").sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPost = posts[0]; const remainingPosts = posts.slice(1);
const popularTags = ["positive parenting","toddler","positive-parenting","toddler discipline","preschooler"];
const popularPosts = remainingPosts.filter((p) => p.data.tags && p.data.tags.some((tag) => popularTags.some(pt => tag.toLowerCase().includes(pt)))).slice(0, 6);
const popularIds = new Set(popularPosts.map(p => p.id));
const guidePosts = remainingPosts.filter((p) => !popularIds.has(p.id) && p.data.description && (p.data.description.toLowerCase().includes("guide") || p.data.description.toLowerCase().includes("complete"))).slice(0, 6);
const guideIds = new Set(guidePosts.map(p => p.id));
const allRemainingPosts = remainingPosts.filter((p) => !popularIds.has(p.id) && !guideIds.has(p.id));
---
<BaseLayout title={`${t("blog.title")} | ${t("site.title")}`} description={t("blog.desc")} lang={lang}>
  <Header lang={lang} />
  <main class="blog-listing">
    <div class="container">
      <div class="listing-header">
        <h1>{t("blog.title")}</h1>
        <p>{t("blog.desc")}</p>
      </div>
      {featuredPost && (
        <a href={`/${lang}/blog/${featuredPost.id}`} class="featured-card">
          {featuredPost.data.image && (
            <div class="featured-image-wrap">
              <img src={featuredPost.data.image} alt={featuredPost.data.title} loading="eager" class="featured-image" />
            </div>
          )}
          <div class="featured-content">
            <span class="featured-label">Featured</span>
            <h2 class="featured-title">{featuredPost.data.title}</h2>
            <p class="featured-desc">{featuredPost.data.description}</p>
            <time datetime={featuredPost.data.pubDate.toISOString()} class="featured-date">
              {featuredPost.data.pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
            </time>
          </div>
        </a>
      )}
      <div class="topic-buttons">
        <a href="/en/topics/montessori" class="topic-btn">Montessori</a>
        <a href="/en/topics/positive-parenting" class="topic-btn">Positive Parenting</a>
      </div>
      {popularPosts.length > 0 && (
        <section class="post-section">
          <h2 class="section-title">Popular Questions</h2>
          <div class="posts-grid">
            {popularPosts.map((post) => (
              <article class="post-card">
                {post.data.image && (<img src={post.data.image} alt={post.data.title} loading="lazy" class="post-card-image" />)}
                <div class="post-card-body">
                  <div class="post-meta"><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</time></div>
                  <h3><a href={`/${lang}/blog/${post.id}`}>{post.data.title}</a></h3>
                  <p>{post.data.description}</p>
                  {post.data.tags && post.data.tags.length > 0 && (<div class="post-tags">{post.data.tags.slice(0, 3).map((tag) => (<span class="tag">{tag}</span>))}</div>)}
                </div>
              </article>
            ))}
          </div>
        </section>
      )}
      {guidePosts.length > 0 && (
        <section class="post-section">
          <h2 class="section-title">Complete Guides</h2>
          <div class="posts-grid">
            {guidePosts.map((post) => (
              <article class="post-card">
                {post.data.image && (<img src={post.data.image} alt={post.data.title} loading="lazy" class="post-card-image" />)}
                <div class="post-card-body">
                  <div class="post-meta"><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</time></div>
                  <h3><a href={`/${lang}/blog/${post.id}`}>{post.data.title}</a></h3>
                  <p>{post.data.description}</p>
                  {post.data.tags && post.data.tags.length > 0 && (<div class="post-tags">{post.data.tags.slice(0, 3).map((tag) => (<span class="tag">{tag}</span>))}</div>)}
                </div>
              </article>
            ))}
          </div>
        </section>
      )}
      <section class="post-section">
        <h2 class="section-title">All Articles</h2>
        {allRemainingPosts.length > 0 ? (
          <div class="posts-grid">
            {allRemainingPosts.map((post) => (
              <article class="post-card">
                {post.data.image && (<img src={post.data.image} alt={post.data.title} loading="lazy" class="post-card-image" />)}
                <div class="post-card-body">
                  <div class="post-meta"><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</time></div>
                  <h3><a href={`/${lang}/blog/${post.id}`}>{post.data.title}</a></h3>
                  <p>{post.data.description}</p>
                  {post.data.tags && post.data.tags.length > 0 && (<div class="post-tags">{post.data.tags.slice(0, 3).map((tag) => (<span class="tag">{tag}</span>))}</div>)}
                </div>
              </article>
            ))}
          </div>
        ) : (posts.length === 0 && (<div class="empty-state"><p>{t("blog.empty")}</p></div>))}
      </section>
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<!-- CSS shared with zh/blog/index.astro via src/styles/blog-index.css — keep in sync -->
<style>
  @import '../../../styles/blog-index.css';
</style>