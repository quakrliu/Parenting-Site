---
import BlogPost from '../../../layouts/BlogPost.astro';
import { getCollection } from 'astro:content';

const lang = 'en';

export async function getStaticPaths() {
  // Only English posts live under /en/ — Chinese posts are built under /zh/ only
  const posts = (await getCollection('blog')).filter((post) => post.data.lang !== 'zh-TW');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<BlogPost post={post} lang={lang} pageUrl={Astro.url.href} />
