---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HomeHero from '../../components/HomeHero.astro';
import FeaturedArticles from '../../components/FeaturedArticles.astro';
import PodcastSection from '../../components/PodcastSection.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';
import AgeNavigator from '../../components/AgeNavigator.astro';
import TopicsSection from '../../components/TopicsSection.astro';

const lang = 'en';
const t = useTranslations(lang);

const allPosts = await getCollection('blog');
const now = new Date();
const featuredPosts = allPosts
  .filter((post) => post.data.pubDate <= now && post.data.lang === 'en')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "BloomPath",
  alternateName: "育見未來",
  url: "https://bloom-path.app",
  logo: "https://bloom-path.app/logo-nav.png",
  sameAs: [
    "https://www.youtube.com/@BloomPathParenting",
    "https://www.youtube.com/@%E8%82%B2%E8%A6%8B%E6%9C%AA%E4%BE%86BloomPath-%E4%B8%AD%E6%96%87",
  ],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "BloomPath",
  url: "https://bloom-path.app/en/",
  inLanguage: "en",
  publisher: { "@type": "Organization", name: "BloomPath" },
};
---

<BaseLayout
  title={`${t('site.title')} | ${t('site.tagline')}`}
  description={t('site.description')}
  lang={lang}
  jsonLd={[organizationSchema, websiteSchema]}
>
  <Header lang={lang} />
  <HomeHero lang={lang} />
  <FeaturedArticles lang={lang} posts={featuredPosts} />
  <TopicsSection lang={lang} />
  <AgeNavigator lang={lang} />
  <PodcastSection lang={lang} />
  <Footer lang={lang} />
</BaseLayout>
