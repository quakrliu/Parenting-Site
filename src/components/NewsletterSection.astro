---
import { useTranslations } from '../i18n/utils';
import NewsletterForm from './NewsletterForm.astro';

interface Props {
  lang: 'en' | 'zh';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="newsletter" class="newsletter">
  <div class="container">
    <div class="newsletter__inner">
      <div class="newsletter__content">
        <span class="eyebrow eyebrow--light">{t('section.newsletter')}</span>
        <h2>{t('section.newsletter.title')}</h2>
        <p>{t('section.newsletter.desc')}</p>
      </div>
      <div class="newsletter__form">
        <NewsletterForm lang={lang} variant="dark" source="homepage" />
      </div>
    </div>
  </div>
</section>

<style>
  .newsletter {
    padding: 6rem 0;
    background: var(--color-forest-dark);
    color: var(--color-white);
  }

  .newsletter__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .newsletter h2 {
    color: var(--color-white);
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .newsletter__content p {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1rem;
    line-height: 1.7;
    margin-top: 0.75rem;
    max-width: 45ch;
  }

  @media (max-width: 1023px) {
    .newsletter__inner { grid-template-columns: 1fr; }
  }

  @media (max-width: 639px) {
    .newsletter { padding: 3.5rem 0; }
  }
</style>
