---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'en' | 'zh';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Placeholder: replace with actual latest video embed ID when available
const youtubeChannelUrl = 'https://www.youtube.com/@BloomPathParenting';
const youtubeEmbedUrl = 'https://www.youtube.com/embed?listType=user_uploads&list=BloomPathParenting';
---

<section id="podcast" class="podcast">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">{t('section.podcast')}</span>
      <h2>{t('section.podcast.title')}</h2>
      <p class="section-desc">{t('section.podcast.desc')}</p>
    </div>

    <div class="podcast__embed-wrap">
      <iframe
        class="podcast__iframe"
        src={youtubeEmbedUrl}
        title="BloomPath Parenting YouTube Channel"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>

    <div class="podcast__cta">
      <a
        href={youtubeChannelUrl}
        class="btn btn--ghost"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        {t('section.podcast.cta')}
      </a>
    </div>
  </div>
</section>

<style>
  .podcast {
    padding: 6rem 0;
    background: var(--color-cream, #F5F0EB);
  }

  .podcast .section-header {
    text-align: center;
    margin-bottom: 2.75rem;
  }

  .podcast .section-desc {
    max-width: 52ch;
    margin-left: auto;
    margin-right: auto;
  }

  .podcast__embed-wrap {
    position: relative;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 20px 60px -20px rgba(141, 155, 142, 0.22);
    background: #000;
    aspect-ratio: 16 / 9;
  }

  .podcast__iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .podcast__cta {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .podcast__cta .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (max-width: 639px) {
    .podcast {
      padding: 3.5rem 0;
    }
  }
</style>
