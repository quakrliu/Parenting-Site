---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: 'en' | 'zh';
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const books = [
  {
    title: 'The Positive Parenting Toolkit',
    subtitle: '30 Days to a Calmer Home',
    link: 'https://www.amazon.com/dp/B0FNBYBQZQ',
    price: '$4.99',
  },
  {
    title: "Your Child's First 3 Years",
    subtitle: 'A Milestone Guide for Anxious Parents',
    link: 'https://www.amazon.com/dp/B0GVN67RLV',
    price: '$4.99',
  },
  {
    title: 'Montessori at Home',
    subtitle: "A Beginner's Guide for Busy Parents",
    link: 'https://www.amazon.com/dp/B0GVPNRL4F',
    price: '$4.99',
  },
];
---

<section class="books-section">
  <div class="books-inner">
    <div class="books-header">
      <span class="books-tag">{t('books.section')}</span>
      <h2 class="books-heading">{t('books.section.title')}</h2>
      <p class="books-desc">{t('books.section.desc')}</p>
    </div>
    <div class="books-grid">
      {books.map((book) => (
        <div class="book-card">
          <div class="book-card-body">
            <h3 class="book-title">{book.title}</h3>
            <p class="book-subtitle">{book.subtitle}</p>
            <p class="book-price">{book.price}</p>
          </div>
          <a
            href={book.link}
            target="_blank"
            rel="noopener noreferrer"
            class="book-cta"
          >
            {t('books.cta')}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.books-section {
  padding: 5rem 1.5rem;
  background: var(--color-cream);
}

.books-inner {
  max-width: 1100px;
  margin: 0 auto;
}

.books-header {
  margin-bottom: 2.5rem;
}

.books-tag {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-forest);
  margin-bottom: 0.6rem;
}

.books-heading {
  font-size: clamp(1.6rem, 3vw, 2.1rem);
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.25;
  margin-bottom: 0.6rem;
}

.books-desc {
  color: var(--color-text-light);
  font-size: 1rem;
  max-width: 52ch;
  line-height: 1.7;
}

.books-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.book-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 1.5rem;
  padding: 2rem;
  border: 1px solid var(--color-divider);
  border-radius: 12px;
  background: var(--color-white);
  transition: box-shadow 0.2s ease, border-color 0.2s ease;
}

.book-card:hover {
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  border-color: var(--color-forest);
}

.book-card-body {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.book-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.3;
}

.book-subtitle {
  font-size: 0.9rem;
  color: var(--color-text-light);
  line-height: 1.6;
}

.book-price {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--color-forest);
  margin-top: 0.25rem;
}

.book-cta {
  display: inline-block;
  align-self: flex-start;
  background: var(--color-forest);
  color: var(--color-white);
  font-weight: 600;
  font-size: 0.9rem;
  padding: 0.65rem 1.4rem;
  border-radius: 8px;
  text-decoration: none;
  transition: background 0.2s ease;
}

.book-cta:hover {
  background: var(--color-forest-dark);
}

@media (max-width: 900px) {
  .books-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .books-grid {
    grid-template-columns: 1fr;
  }
}
</style>
